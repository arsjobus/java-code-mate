#!/bin/sh
# javelin - open a directory as a project in javelin IDE (macOS).
#
#   javelin            open the current directory
#   javelin path/to/x  open that directory
#
# If javelin IDE is not running it is started with the directory as its argument. If it is already running, macOS
# cannot pass it new arguments, so the directory is left as a small request file that the running window picks up
# within a second (see OpenRequests.java for the format), and the window is brought to the front.
set -eu

APP_NAME="${JAVALIN_IDE_APP_NAME:-javelin IDE}"
CONFIG_DIR="${JAVALIN_IDE_CONFIG_DIR:-$HOME/Library/Application Support/javelin-ide}"

usage() {
  echo "usage: javelin [directory]"
  echo "Opens the directory (default: the current one) as a project in $APP_NAME."
}

case "${1-}" in
  -h|--help) usage; exit 0 ;;
esac

if [ "$#" -gt 1 ]; then
  echo "javelin: expected at most one directory" >&2
  usage >&2
  exit 2
fi

target="${1:-.}"
if [ ! -d "$target" ]; then
  echo "javelin: not a directory: $target" >&2
  exit 1
fi
dir=$(cd "$target" && pwd -P)

not_installed() {
  echo "javelin: could not open $APP_NAME. Is it installed? (packaging/macos/install.sh)" >&2
  exit 1
}

if pgrep -x "$APP_NAME" >/dev/null 2>&1; then
  requests="$CONFIG_DIR/open-requests"
  mkdir -p "$requests"
  name="$(date +%s)-$$"
  printf '%s\n' "$dir" > "$requests/.$name.tmp"
  mv "$requests/.$name.tmp" "$requests/$name.request"
  open -a "$APP_NAME" || not_installed
else
  open -a "$APP_NAME" --args "$dir" || not_installed
fi
